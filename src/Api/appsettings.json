{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Jwt": {
    "Secret": "super-secret-key-change-in-production-minimum-32-chars",
    "Issuer": "AiKnowledgeBase",
    "Audience": "AiKnowledgeBase",
    "ExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=ai_knowledge_base;Username=postgres;Password=postgres"
  }
}
